@{
    ViewData["Title"] = "Demo";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/Portada/Css/Gstyle.css" />
    <link rel="stylesheet" href="~/Portada/Css/Demo.css" />
    <link rel="stylesheet" href="~/Portada/Css/Buttons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- ESTILOS DE EMERGENCIA PARA FORZAR LA VISTA -->
    <style>
        /* FORZAR body.demo-page */
        body {
            background: linear-gradient(135deg, #05162c 0%, #0a192f 50%, #05162c 100%) !important;
            min-height: 100vh !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 20px !important;
            margin: 0 !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
        }

        /* Asegurar que el contenido sea visible */
        main {
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        /* Contenedor principal de Demo */
        .demo-wrapper {
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            width: 100% !important;
            min-height: 100vh !important;
            padding-top: 80px !important;
        }

        /* Forzar visibilidad del formulario */
        .container {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            width: 1000px !important;
            height: 600px !important;
            background: rgba(15, 35, 65, 0.85) !important;
            border-radius: 30px !important;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.4), 0 0 80px rgba(0, 180, 255, 0.2) !important;
            border: 1px solid rgba(0, 180, 255, 0.2) !important;
            position: relative !important;
            overflow: hidden !important;
        }

        /* Navbar para Demo */
        .navbar.demo-nav {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            background: rgba(10, 25, 47, 0.95) !important;
            backdrop-filter: blur(10px) !important;
            border-bottom: 1px solid rgba(0, 180, 255, 0.2) !important;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3) !important;
            z-index: 1000 !important;
            padding: 0 20px !important;
        }

            .navbar.demo-nav ul {
                display: flex !important;
                justify-content: center !important;
                align-items: center !important;
                height: 80px !important;
                margin: 0 !important;
                padding: 0 !important;
                list-style: none !important;
            }

            .navbar.demo-nav .home {
                margin: 0 20px !important;
            }

                .navbar.demo-nav .home a {
                    display: flex !important;
                    flex-direction: column !important;
                    align-items: center !important;
                    text-decoration: none !important;
                    color: #a0d2ff !important;
                    transition: all 0.3s ease !important;
                    padding: 10px !important;
                }

                    .navbar.demo-nav .home a.active {
                        color: #00b4ff !important;
                    }
    </style>
}