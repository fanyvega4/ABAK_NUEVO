@using System.Linq
@model IEnumerable<ABAK_NUEVO.Models.Identity.HistorialAccesoVM>

@{
    ViewData["Title"] = "Historial de accesos";

    string email = ViewBag.EmailFiltro ?? "";
    string accion = ViewBag.AccionFiltro ?? "Todas";
    string seccion = ViewBag.SeccionFiltro ?? "Todas";
    string desde = ViewBag.DesdeFiltro ?? "";
    string hasta = ViewBag.HastaFiltro ?? "";
    int total = ViewBag.TotalRegistros ?? 0;

    var movimientos = Model ?? Enumerable.Empty<ABAK_NUEVO.Models.Identity.HistorialAccesoVM>();
    int logins = movimientos.Count(m => m.Accion == "Login");
    int logouts = movimientos.Count(m => m.Accion == "Logout");
    int registros = movimientos.Count(m => m.Accion == "Registro");
    int usuariosDistintos = movimientos.Select(m => m.Email).Distinct().Count();
}

@section Styles {
    <style>
        :root {
            --abak-bg: #020817;
            --abak-gradient-top: #00e6ff;
            --abak-gradient-mid: #001226;
            --abak-card-bg: rgba(6, 15, 32, 0.96);
            --abak-cyan: #39f5ff;
            --abak-green: #24ffb4;
            --abak-red: #ff6b81;
            --abak-orange: #ffb347;
            --abak-text: #e6f4ff;
            --abak-muted: #8ca0c3;
            --abak-border-soft: rgba(0, 245, 255, .25);
        }

        body {
            background: radial-gradient(circle at top, var(--abak-gradient-top) 0, #021223 40%, #000711 100%);
            color: var(--abak-text);
            font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .hist-page {
            min-height: calc(100vh - 0px);
            padding: 32px 0 48px;
        }

        /* CONTORNO OSCURO Y PANEL BLANCO INTERNO */
        .hist-shell {
            max-width: 1100px;
            margin: 0 auto;
            border-radius: 30px;
            background: radial-gradient(circle at top, rgba(0, 255, 255, .25), rgba(3, 12, 30, .98));
            box-shadow: 0 24px 60px rgba(0, 0, 0, .9);
            padding: 4px;
            position: relative;
        }

        .hist-inner {
            background: #ffffff;
            border-radius: 24px;
            padding: 18px 22px 24px;
            color: #111827;
            position: relative;
            overflow: hidden;
        }

        /* TOP BAR */
        .hist-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
            font-size: .85rem;
            color: #6b7280;
        }

        .hist-breadcrumb {
            font-size: .8rem;
        }

            .hist-breadcrumb a {
                color: #0ea5e9;
                text-decoration: none;
            }

                .hist-breadcrumb a:hover {
                    text-decoration: underline;
                }

        .hist-topbtn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            border-radius: 999px;
            border: 1px solid #0ea5e9;
            background: radial-gradient(circle at top, #022335, #020817);
            color: #e6f4ff;
            font-size: .78rem;
            letter-spacing: .14em;
            text-transform: uppercase;
            text-decoration: none;
            box-shadow: 0 10px 24px rgba(0, 0, 0, .8);
            transition: all .18s ease-out;
        }

            .hist-topbtn:hover {
                transform: translateY(-1px);
                box-shadow: 0 16px 30px rgba(0, 0, 0, .9);
                background: linear-gradient(90deg, #00ffbf33, #00e6ff55);
                text-decoration: none;
            }

        /* HEADER PRINCIPAL */
        .hist-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .hist-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .hist-title {
            font-size: 1.7rem;
            margin: 0;
            letter-spacing: .03em;
            color: #0f172a;
        }

        .hist-sub {
            font-size: .85rem;
            color: #6b7280;
            margin-top: 2px;
        }

        .sak-mini {
            width: 38px;
            height: 38px;
            border-radius: 999px;
            background: radial-gradient(circle at top, #eff6ff, #bfdbfe);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .15);
        }

            .sak-mini img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        .hist-count {
            font-size: .82rem;
            color: #6b7280;
            text-align: right;
        }

            .hist-count strong {
                color: #111827;
            }

        /* MÉTRICAS TIPO DASHBOARD */
        .hist-metrics {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 20px;
        }

        .hist-metric {
            position: relative;
            border-radius: 16px;
            padding: 10px 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .25);
            color: #ffffff;
        }

        .metric-total {
            background: linear-gradient(135deg, #00ffbf, #00c0ff);
        }

        .metric-login {
            background: linear-gradient(135deg, #16a34a, #22c55e);
        }

        .metric-logout {
            background: linear-gradient(135deg, #dc2626, #f97373);
        }

        .metric-registro {
            background: linear-gradient(135deg, #d97706, #f59e0b);
        }

        .hist-metric-label {
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .12em;
            opacity: .9;
        }

        .hist-metric-value {
            font-size: 1.4rem;
            font-weight: 600;
            line-height: 1.1;
        }

        .hist-metric-note {
            font-size: .75rem;
            opacity: .9;
        }

        /* FILTROS */
        .hist-filtros {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 16px;
            margin-bottom: 18px;
            align-items: flex-end;
        }

        .hist-campo {
            display: flex;
            flex-direction: column;
            font-size: .8rem;
        }

            .hist-campo label {
                margin-bottom: 3px;
                font-weight: 600;
                color: #4b5563;
            }

            .hist-campo input,
            .hist-campo select {
                min-width: 150px;
                padding: 6px 10px;
                border-radius: 999px;
                border: 1px solid #d1d5db;
                background: #f9fafb;
                color: #111827;
                font-size: .85rem;
                box-shadow: 0 4px 10px rgba(15, 23, 42, .12);
                outline: none;
                box-sizing: border-box;
            }

                .hist-campo input:focus,
                .hist-campo select:focus {
                    border-color: #0ea5e9;
                    box-shadow: 0 0 0 1px rgba(14, 165, 233, .6), 0 6px 16px rgba(15, 23, 42, .30);
                }

        .hist-btn-filtrar {
            padding: 7px 18px;
            border-radius: 999px;
            border: none;
            background: linear-gradient(90deg, #00ffbf, #00e6ff);
            color: #001018;
            font-size: .8rem;
            font-weight: 600;
            letter-spacing: .16em;
            text-transform: uppercase;
            box-shadow: 0 14px 36px rgba(34, 197, 235, .40);
            cursor: pointer;
            transition: transform .15s, box-shadow .15s;
        }

            .hist-btn-filtrar:hover {
                transform: translateY(-1px);
                box-shadow: 0 18px 46px rgba(34, 197, 235, .55);
            }

        /* TABLA (CUADRO BLANCO) */
        .hist-table-wrapper {
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 14px 32px rgba(15, 23, 42, .18);
            padding: 10px 12px 12px;
            overflow-x: auto;
            color: #111827;
        }

        .hist-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .82rem;
            color: #111827;
            min-width: 640px;
        }

            .hist-table thead {
                background: #f3f4f6;
            }

            .hist-table th,
            .hist-table td {
                padding: 6px 8px;
                border-bottom: 1px solid #e5e7eb;
                white-space: nowrap;
                text-align: center; /* centrado por defecto */
            }

            .hist-table th {
                font-weight: 600;
                font-size: .8rem;
                color: #6b7280;
                text-transform: uppercase;
                letter-spacing: .08em;
            }

                /* Primera columna (FECHA) alineada a la izquierda */
                .hist-table th:first-child,
                .hist-table td:first-child {
                    text-align: left;
                }

                /* Segunda columna (CORREO) alineada a la izquierda */
                .hist-table th:nth-child(2),
                .hist-table td:nth-child(2) {
                    text-align: left;
                }

            .hist-table tbody tr:nth-child(even) {
                background: #f9fafb;
            }

            .hist-table tbody tr:hover {
                background: #e0f2fe;
            }

        /* Píldoras de sección y acción (más fuertes) */
        .badge-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #ffffff;
        }

        .badge-sec-login {
            background: #2563eb;
        }

        .badge-sec-general {
            background: #059669;
        }

        .badge-sec-manual {
            background: #7c3aed;
        }

        .badge-sec-cap {
            background: #d97706;
        }

        .badge-sec-mat {
            background: #16a34a;
        }

        .badge-sec-other {
            background: #4b5563;
        }

        /* Acciones con mismos tonos que las métricas */
        .badge-act-login {
            background: #16a34a;
        }
        /* verde acceso */
        .badge-act-logout {
            background: #dc2626;
        }
        /* rojo salida  */
        .badge-act-reg {
            background: #d97706;
        }
        /* naranja alta */
        .badge-act-other {
            background: #4b5563;
        }

        /* Resaltar ADMIN */
        .cell-admin {
            color: #b91c1c;
            font-weight: 700;
        }

        .hist-vacio {
            margin-top: 10px;
            font-size: .8rem;
            color: #6b7280;
        }

        /* Robot de fondo en el contorno oscuro */
        .sak-bg {
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 160px;
            opacity: .15;
            pointer-events: none;
        }

        @@keyframes sak-breathe {
            0% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }

            100% {
                transform: translateY(0);
            }
        }

        .sak-breathe {
            animation: sak-breathe 3.8s ease-in-out infinite;
        }

        @@media (max-width: 900px) {
            .hist-shell {
                margin: 0 10px;
            }

            .hist-inner {
                padding: 16px 14px 20px;
            }

            .hist-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .hist-count {
                text-align: left;
            }

            .hist-metrics {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 600px) {
            .hist-metrics {
                grid-template-columns: minmax(0, 1fr);
            }
        }
    </style>
}

<div class="hist-page">
    <div class="hist-shell">
        <div class="hist-inner">
            <div class="hist-topbar">
                <div class="hist-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Inicio</a> &gt; Historial de accesos
                </div>

                <div style="display:flex; gap:8px;">
                    <!-- Botón a Panel de administración -->
                    <a asp-controller="Admin" asp-action="Index" class="hist-topbtn">
                        ADMIN
                    </a>
                    <!-- Botón a Inicio -->
                    <a asp-controller="Home" asp-action="Index" class="hist-topbtn">
                        INICIO
                    </a>
                </div>
            </div>

            <div class="hist-header">
                <div class="hist-header-left">
                    <div class="sak-mini">
                        <img src="~/Portada/images/Sak/Sak.error.png" alt="Sak historial" />
                    </div>
                    <div>
                        <h1 class="hist-title">Historial de accesos</h1>
                        <div class="hist-sub">
                            Monitoreo de entradas, salidas y registros de usuarios en el portal ABAK.
                        </div>
                    </div>
                </div>
                <div class="hist-count">
                    Registros filtrados: <strong>@total</strong><br />
                    Usuarios distintos: <strong>@usuariosDistintos</strong>
                </div>
            </div>

            <!-- MÉTRICAS -->
            <div class="hist-metrics">
                <div class="hist-metric metric-total">
                    <div class="hist-metric-label">Movimientos</div>
                    <div class="hist-metric-value">@total</div>
                    <div class="hist-metric-note">Registros dentro del filtro actual</div>
                </div>
                <div class="hist-metric metric-login">
                    <div class="hist-metric-label">Logins</div>
                    <div class="hist-metric-value">@logins</div>
                    <div class="hist-metric-note">Entradas al sistema</div>
                </div>
                <div class="hist-metric metric-logout">
                    <div class="hist-metric-label">Logouts</div>
                    <div class="hist-metric-value">@logouts</div>
                    <div class="hist-metric-note">Cierres de sesión</div>
                </div>
                <div class="hist-metric metric-registro">
                    <div class="hist-metric-label">Registros</div>
                    <div class="hist-metric-value">@registros</div>
                    <div class="hist-metric-note">Altas de cuenta</div>
                </div>
            </div>

            <!-- FILTROS -->
            <form method="get" class="hist-filtros">
                <div class="hist-campo">
                    <label for="email">Correo</label>
                    <input id="email" type="text" name="email" value="@email" />
                </div>

                <div class="hist-campo">
                    <label for="accion">Acción</label>
                    <select id="accion" name="accion">
                        <option value="Todas" selected="@("Todas" == accion)">Todas</option>
                        <option value="Login" selected="@("Login" == accion)">Login</option>
                        <option value="Logout" selected="@("Logout" == accion)">Logout</option>
                        <option value="Registro" selected="@("Registro" == accion)">Registro</option>
                    </select>
                </div>

                <div class="hist-campo">
                    <label for="seccion">Sección</label>
                    <select id="seccion" name="seccion">
                        <option value="Todas" selected="@("Todas" == seccion)">Todas</option>
                        <option value="Login" selected="@("Login" == seccion)">Login</option>
                        <option value="General" selected="@("General" == seccion)">General</option>
                        @* agrega aquí más secciones si las usas *@
                    </select>
                </div>

                <div class="hist-campo">
                    <label for="desde">Desde</label>
                    <input id="desde" type="date" name="desde" value="@desde" />
                </div>

                <div class="hist-campo">
                    <label for="hasta">Hasta</label>
                    <input id="hasta" type="date" name="hasta" value="@hasta" />
                </div>

                <div class="hist-campo">
                    <button type="submit" class="hist-btn-filtrar">Filtrar</button>
                </div>
            </form>

            <!-- TABLA -->
            <div class="hist-table-wrapper">
                <table class="hist-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Correo</th>
                            <th>Usuario</th>
                            <th>Sección</th>
                            <th>Acción</th>
                            <th>IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (movimientos.Any())
                        {
                            foreach (var item in movimientos)
                            {
                                var esAdmin = !string.IsNullOrEmpty(item.Nombre)
                                && item.Nombre.Contains("Administrador", System.StringComparison.OrdinalIgnoreCase);

                                string seccionClass = item.Seccion switch
                                {
                                    "Login" => "badge-sec-login",
                                    "General" => "badge-sec-general",
                                    "ManualAyuda" => "badge-sec-manual",
                                    "Capacitacion" => "badge-sec-cap",
                                    "MaterialLibre" => "badge-sec-mat",
                                    _ => "badge-sec-other"
                                };

                                string accionClass = item.Accion switch
                                {
                                    "Login" => "badge-act-login",
                                    "Logout" => "badge-act-logout",
                                    "Registro" => "badge-act-reg",
                                    _ => "badge-act-other"
                                };

                                <tr>
                                    <td>@item.FechaAcceso.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td class="@(esAdmin ? "cell-admin" : "")">@item.Email</td>
                                    <td class="@(esAdmin ? "cell-admin" : "")">@item.Nombre</td>
                                    <td>
                                        <span class="badge-pill @seccionClass">@item.Seccion</span>
                                    </td>
                                    <td>
                                        <span class="badge-pill @accionClass">@item.Accion</span>
                                    </td>
                                    <td>@item.DireccionIP</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">No hay registros que coincidan con los filtros seleccionados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!movimientos.Any())
            {
                <div class="hist-vacio">
                    Ajusta los filtros (fechas, acción, sección o correo) para ver otros movimientos.
                </div>
            }
        </div>

        <img src="~/Portada/images/Sak/Sak.sorpresa.png" alt="Sak fondo" class="sak-bg sak-breathe" />
    </div>
</div>
