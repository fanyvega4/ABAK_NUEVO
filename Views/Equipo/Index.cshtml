@{
    ViewData["Title"] = "Equipo";
}

@section Styles {
    <!-- ESTILO DE EMERGENCIA - FONDO FORZADO -->
    <style>
        /* FONDO AZUL NEON CON NEGRO - FORZADO */
        body {
            background: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .team {
            background: linear-gradient(135deg, #000000 0%, #001122 25%, #003366 50%, #005588 75%, #001122 100%) !important;
            min-height: 100vh !important;
            width: 100% !important;
        }
    </style>

    <!-- Estilos globales y específicos -->
    <link rel="stylesheet" href="~/Portada/Css/Gstyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portada/Css/Equipo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portada/Css/Buttons.css" asp-append-version="true" />

    <!-- Iconos y favicon -->
    <link rel="icon" href="~/Portada/images/Abak.ico" type="image/x-icon" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Estilos adicionales para las tarjetas de presentación -->
    <style>
        /* Estilos para los botones y tarjetas de presentación */
        .show-more-btn {
            margin-top: 15px;
            padding: 10px 25px;
            background: #00AEEF;
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            z-index: 10;
            position: relative;
        }

            .show-more-btn:hover {
                background: #0088cc;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 174, 239, 0.4);
            }

        /* Tarjeta de presentación (inicialmente oculta) */
        .presentation-card {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            width: 90vw;
            max-width: 500px;
            max-height: 85vh;
            background: #1a1a1a;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
            z-index: 1001;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid #00AEEF;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: #00AEEF #1a1a1a;
        }

            .presentation-card::-webkit-scrollbar {
                width: 6px;
            }

            .presentation-card::-webkit-scrollbar-track {
                background: #1a1a1a;
                border-radius: 10px;
            }

            .presentation-card::-webkit-scrollbar-thumb {
                background: #00AEEF;
                border-radius: 10px;
            }

            .presentation-card.active {
                opacity: 1;
                visibility: visible;
                transform: translate(-50%, -50%) scale(1);
            }

        /* Fondo oscuro cuando se muestra la tarjeta */
        .card-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            backdrop-filter: blur(3px);
        }

            .card-overlay.active {
                opacity: 1;
                visibility: visible;
            }

        /* Contenido de la tarjeta de presentación */
        .card-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: nowrap;
        }

        .card-avatar {
            width: 80px;
            height: 80px;
            min-width: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #00AEEF;
            box-shadow: 0 5px 15px rgba(0, 174, 239, 0.3);
        }

        .card-title {
            flex: 1;
        }

            .card-title h3 {
                color: white;
                font-size: 1.4rem;
                margin-bottom: 5px;
                line-height: 1.2;
                font-weight: 700;
            }

            .card-title p {
                color: #00AEEF;
                font-size: 0.95rem;
                font-weight: 600;
                margin: 0;
            }

        .card-content {
            color: #e0e0e0;
            line-height: 1.6;
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

            .card-content p {
                margin-bottom: 15px;
            }

                .card-content p:last-child {
                    margin-bottom: 0;
                }

        .card-skills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 25px;
        }

        .skill-tag {
            background: rgba(0, 174, 239, 0.15);
            color: #00AEEF;
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            border: 1px solid rgba(0, 174, 239, 0.3);
            transition: all 0.3s ease;
        }

            .skill-tag:hover {
                background: rgba(0, 174, 239, 0.25);
                transform: translateY(-2px);
            }

        .card-contact {
            display: flex;
            gap: 20px;
            justify-content: center;
            padding-top: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .contact-link {
            color: #b8b8b8;
            font-size: 1.3rem;
            transition: all 0.3s ease;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
        }

            .contact-link:hover {
                color: #00AEEF;
                background: rgba(0, 174, 239, 0.1);
                transform: translateY(-3px);
            }

        .close-card {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: #b8b8b8;
            font-size: 1.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            z-index: 1002;
            line-height: 1;
        }

            .close-card:hover {
                color: #00AEEF;
                background: rgba(255, 255, 255, 0.15);
                transform: rotate(90deg);
            }

        /* @@media EN LUGAR DE - CORREGIDO PARA RAZOR */
        @@media screen and (max-width: 768px) {
            .presentation-card {
                width: 95vw;
                padding: 20px;
                max-height: 90vh;
                border-radius: 12px;
            }

            .card-header {
                gap: 15px;
            }

            .card-avatar {
                width: 70px;
                height: 70px;
                min-width: 70px;
            }

            .card-title h3 {
                font-size: 1.3rem;
            }

            .card-title p {
                font-size: 0.9rem;
            }

            .card-content {
                font-size: 0.9rem;
                line-height: 1.5;
            }

            .card-skills {
                gap: 8px;
            }

            .skill-tag {
                font-size: 0.8rem;
                padding: 5px 12px;
            }

            .contact-link {
                font-size: 1.2rem;
                width: 35px;
                height: 35px;
            }

            .close-card {
                top: 10px;
                right: 10px;
                width: 35px;
                height: 35px;
                font-size: 1.5rem;
            }
        }

        @@media screen and (max-width: 480px) {
            .presentation-card {
                width: 98vw;
                padding: 18px 15px;
                border-radius: 10px;
            }

            .card-header {
                flex-direction: column;
                text-align: center;
                gap: 12px;
            }

            .card-avatar {
                width: 90px;
                height: 90px;
                min-width: 90px;
            }

            .card-title h3 {
                font-size: 1.2rem;
            }

            .card-content p {
                margin-bottom: 12px;
            }

            .card-skills {
                justify-content: center;
            }

            .skill-tag {
                font-size: 0.75rem;
                padding: 4px 10px;
            }

            .card-contact {
                gap: 15px;
            }

            .contact-link {
                font-size: 1.1rem;
                width: 32px;
                height: 32px;
            }
        }

        @@media screen and (max-height: 600px) {
            .presentation-card {
                max-height: 95vh;
                top: 50%;
                transform: translate(-50%, -50%) scale(0.9);
            }

                .presentation-card.active {
                    transform: translate(-50%, -50%) scale(1);
                }
        }
    </style>
}

