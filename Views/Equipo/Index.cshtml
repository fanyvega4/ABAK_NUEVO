@section Scripts {
    <script>
        // Efecto de navbar al hacer scroll
        window.addEventListener("scroll", function () {
            const navbar = document.querySelector(".navbar");
            if (!navbar) return;
            navbar.classList.toggle("scrolled", window.scrollY > 50);
        });

        // FUNCIONALIDAD PARA LAS TARJETAS DE PRESENTACIÓN
        document.addEventListener('DOMContentLoaded', function() {
            const showMoreBtns = document.querySelectorAll('.show-more-btn');
            const closeBtns = document.querySelectorAll('.close-card');
            const overlay = document.getElementById('overlay');
            let activeCard = null;

            // Mostrar tarjeta cuando se hace clic en "Ver Presentación"
            showMoreBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const targetId = this.getAttribute('data-target');
                    const card = document.getElementById(`card-${targetId}`);

                    // Si ya hay una tarjeta activa, cerrarla primero
                    if (activeCard) {
                        activeCard.classList.remove('active');
                    }

                    // Mostrar nueva tarjeta
                    card.classList.add('active');
                    overlay.classList.add('active');
                    document.body.style.overflow = 'hidden';
                    activeCard = card;

                    // Enfocar el botón de cerrar para accesibilidad
                    setTimeout(() => {
                        const closeBtn = card.querySelector('.close-card');
                        if (closeBtn) closeBtn.focus();
                    }, 100);
                });
            });

            // Cerrar tarjeta cuando se hace clic en la X
            closeBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const card = this.closest('.presentation-card');
                    card.classList.remove('active');
                    overlay.classList.remove('active');
                    document.body.style.overflow = '';
                    activeCard = null;
                });
            });

            // Cerrar tarjeta cuando se hace clic en el overlay
            overlay.addEventListener('click', function() {
                document.querySelectorAll('.presentation-card').forEach(card => {
                    card.classList.remove('active');
                });
                this.classList.remove('active');
                document.body.style.overflow = '';
                activeCard = null;
            });

            // Cerrar con tecla ESC
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && overlay.classList.contains('active')) {
                    document.querySelectorAll('.presentation-card').forEach(card => {
                        card.classList.remove('active');
                    });
                    overlay.classList.remove('active');
                    document.body.style.overflow = '';
                    activeCard = null;
                }
            });

            // Prevenir que el clic en la tarjeta cierre el modal
            document.querySelectorAll('.presentation-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            });
        });

        // ===== CÓDIGO DE EMERGENCIA PARA FONDO =====
        // ESTO GARANTIZA QUE EL FONDO SE CAMBIE
        window.onload = function() {
            // Forzar cambio de fondo con JavaScript
            var teamDiv = document.querySelector('.team');
            if (teamDiv) {
                // Método 1: Cambiar estilo directamente
                teamDiv.style.background = 'linear-gradient(135deg, #000000 0%, #003366 50%, #000000 100%)';
                teamDiv.style.backgroundColor = '#001133';

                // Método 2: Agregar !important via CSS Text
                teamDiv.style.cssText += 'background: linear-gradient(135deg, #000000, #003366) !important;';

                // Método 3: Inyectar nuevo estilo
                var forceStyle = document.createElement('style');
                forceStyle.innerHTML = '.team { background: linear-gradient(135deg, #000000, #003366) !important; }';
                document.head.appendChild(forceStyle);

                console.log('✅ Fondo cambiado a AZUL NEON CON NEGRO');
            }
        };
    </script>
}