@section Scripts {
    <script>
        // Tu código original del carrusel COMPLETO
        const nextDom = document.getElementById('next');
        const prevDom = document.getElementById('prev');
        const listitemDom = document.querySelector('.carousel .list');
        const thumbnailDom = document.querySelector('.carousel .thumbnail');

        // scroll navbar
        window.addEventListener("scroll", () => {
          const navbar = document.querySelector(".navbar");
          navbar?.classList.toggle("scrolled", window.scrollY > 50);
        });

        // ⚡ VELOCIDAD DEL CAMBIO AUTOMÁTICO (cada 10 segundos - AJUSTABLE)
        let autoSlideInterval = setInterval(() => showSlider('next'), 10000);

        nextDom?.addEventListener('click', () => { showSlider('next'); resetAutoSlide(); });
        prevDom?.addEventListener('click', () => { showSlider('prev'); resetAutoSlide(true); });

        function showSlider(type) {
          const itemSlider = document.querySelectorAll('.carousel .list .itemc');
          const itemThumb  = document.querySelectorAll('.carousel .thumbnail .item');
          listitemDom.classList.add('transitioning');
          thumbnailDom.classList.add('transitioning');

          // ⚡ VELOCIDAD DE LA ANIMACIÓN (0.5 segundos - AJUSTABLE)
          setTimeout(() => {
            if (type === 'next') {
                listitemDom.appendChild(itemSlider[0]);
                thumbnailDom.appendChild(itemThumb[0]);
            }
            else {
                listitemDom.insertBefore(itemSlider[itemSlider.length - 1], itemSlider[0]);
                thumbnailDom.insertBefore(itemThumb[itemThumb.length - 1], itemThumb[0]);
            }
            listitemDom.classList.remove('transitioning');
            thumbnailDom.classList.remove('transitioning');
          }, 500); // 🔧 Cambia este número para ajustar velocidad de animación
        }

        function resetAutoSlide(isPrev) {
          clearInterval(autoSlideInterval);
          setTimeout(() => {
            autoSlideInterval = setInterval(() => showSlider('next'), 10000); // 🔧 Cambia este número para ajustar intervalo
          }, isPrev ? 10000 : 0);
        }

        // NUEVO CÓDIGO AGREGADO: Para la selección de servicios
        document.addEventListener('DOMContentLoaded', function() {
            // Seleccionar elementos
            const serviceCards = document.querySelectorAll('.servicio-card');
            const descriptionPanels = document.querySelectorAll('.descripcion-panel');
            const verMasButtons = document.querySelectorAll('.ver-mas-btn');

            // Función para mostrar un servicio específico
            function mostrarServicio(servicioId) {
                // Remover active de todas las tarjetas
                serviceCards.forEach(card => {
                    card.classList.remove('active');
                });

                // Ocultar todos los paneles
                descriptionPanels.forEach(panel => {
                    panel.classList.remove('active');
                });

                // Activar tarjeta seleccionada
                const tarjetaSeleccionada = document.querySelector(`[data-servicio="${servicioId}"]`);
                if (tarjetaSeleccionada) {
                    tarjetaSeleccionada.classList.add('active');
                }

                // Mostrar panel correspondiente
                const panelSeleccionado = document.getElementById(`descripcion-${servicioId}`);
                if (panelSeleccionado) {
                    panelSeleccionado.classList.add('active');

                    // Scroll suave al panel
                    setTimeout(() => {
                        panelSeleccionado.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }, 300);
                }
            }

            // Event listeners para tarjetas
            serviceCards.forEach(card => {
                card.addEventListener('click', function() {
                    const servicioId = this.getAttribute('data-servicio');
                    mostrarServicio(servicioId);
                });
            });

            // Event listeners para botones "Ver más" del carrusel
            verMasButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const servicioId = this.getAttribute('data-servicio');
                    mostrarServicio(servicioId);
                });
            });

            // Inicializar con Administración activa
            mostrarServicio('administracion');
        });
    </script>
}