@page
@model ABAK_NUEVO.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Mi perfil";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/site.css" />

<style>
    /* FONDO OSCURO TIPO LOGIN */
    body {
        background: radial-gradient(circle at top, #00f5ff 0%, #042f4b 40%, #020617 100%) !important;
        color: #e5e7eb;
    }

    .manage-container-abak {
        max-width: 1200px;
        margin: 40px auto 70px;
        padding: 0 20px;
        color: #e5e7eb;
        font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

        .manage-container-abak a {
            text-decoration: none;
        }

    .perfil-row {
        display: grid;
        grid-template-columns: 2.1fr 1.1fr;
        gap: 24px;
    }

    .card-abak {
        background: rgba(3, 11, 32, 0.98);
        border-radius: 26px;
        padding: 24px 26px;
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.9);
        border: 1px solid rgba(22, 163, 183, 0.25);
    }

    .card-abak-right {
        padding: 22px 22px 26px;
    }

    .perfil-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

        .perfil-header h2 {
            margin: 0;
            font-size: 1.9rem;
            font-weight: 700;
            color: #f9fafb;
        }

        .perfil-header p {
            margin: 3px 0 0;
            font-size: 0.9rem;
            color: #9ca3af;
        }

    .btn-tab-abak {
        border-radius: 999px;
        padding: 0.45rem 1.3rem;
        font-size: 0.82rem;
        border: 1px solid rgba(45, 212, 191, 0.65);
        background: radial-gradient(circle at top, #14f4ff 0%, #0ea5e9 60%, #0f172a 100%);
        color: #0b1020 !important;
        font-weight: 600;
        letter-spacing: .03em;
        box-shadow: 0 10px 28px rgba(34, 211, 238, 0.7);
    }

        .btn-tab-abak:hover {
            filter: brightness(1.08);
        }

    /* GRID DE CAMPOS – inputs más cortos */
    .perfil-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem 1.4rem;
        margin-top: 10px;
    }

    .perfil-field label {
        font-size: 0.82rem;
        font-weight: 500;
        color: #a5b4fc;
        margin-bottom: 4px;
        display: block;
        transition: color 0.15s ease;
    }

    .perfil-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 320px;
    }

    .perfil-input {
        flex: 1;
        border-radius: 999px;
        border: none;
        padding: 0.68rem 3.9rem 0.68rem 1rem;
        background: #020617;
        color: #f9fafb;
        font-size: 0.9rem;
        box-shadow: inset 0 0 0 1px rgba(30, 64, 175, 0.7);
        transition: box-shadow 0.15s ease, background 0.15s ease;
    }

        .perfil-input:read-only {
            opacity: 0.9;
        }

        .perfil-input:focus {
            outline: none;
            box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.95), 0 0 16px rgba(34, 211, 238, 0.8);
        }

    .icon-group {
        position: absolute;
        right: 0.35rem;
        display: flex;
        gap: 0.2rem;
        align-items: center;
    }

    /* SOLO EDITAR (AZUL) Y GUARDAR (VERDE) */
    .icon-btn {
        width: 26px;
        height: 26px;
        border-radius: 999px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
        color: #f9fafb;
        font-size: 0.78rem;
        font-weight: 700;
        transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease, opacity 0.15s ease;
    }

        .icon-btn.edit {
            background: radial-gradient(circle at top, #38bdf8, #1d4ed8);
        }

        .icon-btn.save {
            background: radial-gradient(circle at top, #4ade80, #16a34a);
        }

        .icon-btn:hover {
            transform: translateY(-1px) scale(1.06);
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.8);
            filter: brightness(1.05);
        }

        .icon-btn span {
            pointer-events: none;
            line-height: 1;
        }

    /* ⚡ ESTADO “EDITANDO” MUY MARCADO */
    .perfil-field.editing label {
        color: #7dd3fc;
    }

    .perfil-field.editing .perfil-input {
        background: #020617;
        box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 1), 0 0 18px rgba(56, 189, 248, 0.95);
    }

    .perfil-field.editing .icon-btn.edit {
        opacity: 0.35;
    }

    .perfil-field.editing .icon-btn.save {
        box-shadow: 0 0 16px rgba(74, 222, 128, 1);
        transform: scale(1.08);
    }

    /* 🔹 BOTÓN GUARDAR CAMBIOS – MISMO EFECTO QUE GUARDAR CONTRASEÑA */
    .btn-guardar-perfil {
        margin-top: 18px;
        min-width: 240px;
        border-radius: 999px;
        font-weight: 700;
        padding: 0.7rem 1.7rem;
        font-size: 0.95rem;
        border: none;
        background: linear-gradient(90deg, #00f5ff, #17c3ff);
        color: #02101e;
        letter-spacing: 0.06em;
        box-shadow: 0 18px 36px rgba(34, 211, 238, 0.9);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        transition: box-shadow 0.15s ease, transform 0.1s ease, filter 0.15s ease;
    }

        .btn-guardar-perfil i {
            margin-right: 0.4rem;
            font-size: 0.9rem;
        }

        .btn-guardar-perfil:hover {
            filter: brightness(1.08);
            box-shadow: 0 22px 44px rgba(34, 211, 238, 1), 0 0 18px rgba(34, 211, 238, 0.9);
            transform: translateY(-1px);
        }

        .btn-guardar-perfil:active {
            transform: translateY(1px) scale(0.99);
            box-shadow: 0 12px 24px rgba(34, 211, 238, 0.7);
        }

        .btn-guardar-perfil:focus-visible {
            outline: none;
            box-shadow: 0 0 0 2px #0f172a, 0 0 0 4px #22d3ee, 0 22px 44px rgba(34, 211, 238, 1);
        }

    .status-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: .6rem;
    }

    .status-pill {
        padding: 0.2rem 0.75rem;
        border-radius: 999px;
        font-size: 0.78rem;
        background: rgba(16, 185, 129, 0.12);
        color: #6ee7b7;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

        .status-pill .dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: #22c55e;
        }

    .status-avatar {
        text-align: center;
        margin: 0.6rem 0 1rem;
    }

        .status-avatar img {
            width: 72px;
            height: 72px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

    .status-meta {
        font-size: 0.82rem;
        color: #d1d5db;
        margin-bottom: .8rem;
    }

        .status-meta span {
            display: block;
        }

    .status-description {
        font-size: 0.8rem;
        color: #9ca3af;
    }

    .change-password-btn {
        margin: 1.5rem auto 0;
        min-width: 210px;
        border-radius: 999px;
        font-weight: 600;
        padding: 0.6rem 1.4rem;
        font-size: 0.88rem;
        border: 1px solid rgba(56, 189, 248, 0.8);
        background: linear-gradient(90deg, #0ea5e9, #22d3ee);
        color: #02101e;
        box-shadow: 0 14px 28px rgba(37, 99, 235, 0.8);
        display: block;
        text-align: center;
    }

        .change-password-btn:hover {
            filter: brightness(1.08);
        }

    @@media (max-width: 992px) {
        .perfil-row {
            grid-template-columns: 1fr;
        }

        .card-abak,
        .card-abak-right {
            padding: 20px 18px 24px;
        }

        .perfil-input-wrapper {
            max-width: 100%;
        }
    }
</style>

<div class="manage-container-abak">
    <div class="perfil-row">
        <!-- IZQUIERDA -->
        <div class="card-abak">
            <div class="perfil-header">
                <div>
                    <h2>Mi perfil</h2>
                    <p>Revisa y actualiza la información básica de tu cuenta en ABAK.</p>
                </div>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-tab-abak">
                    Volver al inicio
                </a>
            </div>

            <form id="profile-form" method="post">
                @Html.AntiForgeryToken()

                <div class="perfil-grid">
                    <!-- Nombre -->
                    <div class="perfil-field" data-field="nombre">
                        <label>Nombre</label>
                        <div class="perfil-input-wrapper">
                            <input asp-for="Input.Nombre" class="perfil-input" />
                            <div class="icon-group">
                                <button type="button" class="icon-btn edit btn-edit" title="Editar campo">
                                    <span>✏</span>
                                </button>
                                <button type="button" class="icon-btn save btn-save d-none" title="Guardar campo">
                                    <span>✔</span>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                    </div>

                    <!-- Apellidos -->
                    <div class="perfil-field" data-field="apellidos">
                        <label>Apellidos</label>
                        <div class="perfil-input-wrapper">
                            <input asp-for="Input.Apellidos" class="perfil-input" />
                            <div class="icon-group">
                                <button type="button" class="icon-btn edit btn-edit" title="Editar campo">
                                    <span>✏</span>
                                </button>
                                <button type="button" class="icon-btn save btn-save d-none" title="Guardar campo">
                                    <span>✔</span>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="Input.Apellidos" class="text-danger"></span>
                    </div>

                    <!-- Empresa -->
                    <div class="perfil-field" data-field="empresa">
                        <label>Empresa / Área</label>
                        <div class="perfil-input-wrapper">
                            <input asp-for="Input.Empresa" class="perfil-input" />
                            <div class="icon-group">
                                <button type="button" class="icon-btn edit btn-edit" title="Editar campo">
                                    <span>✏</span>
                                </button>
                                <button type="button" class="icon-btn save btn-save d-none" title="Guardar campo">
                                    <span>✔</span>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="Input.Empresa" class="text-danger"></span>
                    </div>

                    <!-- Teléfono -->
                    <div class="perfil-field" data-field="telefono">
                        <label>Número de contacto</label>
                        <div class="perfil-input-wrapper">
                            <input asp-for="Input.PhoneNumber" class="perfil-input" />
                            <div class="icon-group">
                                <button type="button" class="icon-btn edit btn-edit" title="Editar campo">
                                    <span>✏</span>
                                </button>
                                <button type="button" class="icon-btn save btn-save d-none" title="Guardar campo">
                                    <span>✔</span>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    <!-- Correo -->
                    <div class="perfil-field">
                        <label>Correo electrónico</label>
                        <div class="perfil-input-wrapper">
                            <input asp-for="Input.Email" class="perfil-input" readonly />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- Sección -->
                    <div class="perfil-field" data-field="seccion">
                        <label>Sección de registro</label>
                        <div class="perfil-input-wrapper">
                            <input asp-for="Input.SeccionRegistro" class="perfil-input" />
                            <div class="icon-group">
                                <button type="button" class="icon-btn edit btn-edit" title="Editar campo">
                                    <span>✏</span>
                                </button>
                                <button type="button" class="icon-btn save btn-save d-none" title="Guardar campo">
                                    <span>✔</span>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="Input.SeccionRegistro" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn-guardar-perfil">
                    <i class="fa fa-save"></i> Guardar cambios
                </button>
            </form>
        </div>

        <!-- DERECHA -->
        <div class="card-abak card-abak-right">
            <div class="status-header">
                <span class="status-pill">
                    <span class="dot"></span> General
                </span>
            </div>

            <div class="status-avatar">
                <img src="~/Portada/images/Sak/Sak.principal.png"
                     alt="Sak"
                     onerror="this.style.display='none';" />
            </div>

            <div class="status-meta">
                <span>Registro: <strong>@Model.FechaRegistro?.ToString("dd/MM/yyyy HH:mm")</strong></span>
                <span>Último acceso: <strong>@Model.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm")</strong></span>
            </div>

            <p class="status-description">
                Estos datos te ayudan a controlar tu actividad dentro del portal ABAK.
                Tu información se utiliza únicamente con fines de acceso y personalización de la plataforma.
            </p>

            <a asp-page="./ChangePassword" class="change-password-btn">
                Cambiar contraseña
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // lógica de editar / guardar por campo
        document.querySelectorAll('.perfil-field').forEach(function (field) {
            const input = field.querySelector('.perfil-input');
            const editBtn = field.querySelector('.btn-edit');
            const saveBtn = field.querySelector('.btn-save');

            if (!input || !editBtn || !saveBtn) return;

            // todos empiezan en solo lectura
            if (!input.hasAttribute('readonly')) {
                input.readOnly = true;
            } else {
                input.readOnly = true;
            }

            editBtn.addEventListener('click', function () {
                input.readOnly = false;
                input.focus();
                editBtn.classList.add('d-none');
                saveBtn.classList.remove('d-none');

                // marcar visualmente el campo como "editando"
                field.classList.add('editing');
            });

            saveBtn.addEventListener('click', function () {
                input.readOnly = true;
                saveBtn.classList.add('d-none');
                editBtn.classList.remove('d-none');

                // quitar estado de edición
                field.classList.remove('editing');
            });
        });
    </script>
}
