@page
@model ABAK_NUEVO.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: radial-gradient(circle at top, #00f5ff 0%, #042f4b 40%, #020617 100%) !important;
        color: #e5e7eb;
    }

    .manage-container-abak {
        max-width: 1200px;
        margin: 40px auto 70px;
        padding: 0 20px;
        color: #e5e7eb;
        font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

        .manage-container-abak a {
            text-decoration: none;
        }

    .cp-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .cp-header h2 {
            margin: 0;
            font-size: 1.9rem;
            font-weight: 700;
            color: #f9fafb;
        }

    .cp-subtitle {
        margin: 4px 0 0;
        font-size: 0.9rem;
        color: #d1d5db;
    }

    .btn-tab-abak {
        border-radius: 999px;
        padding: 0.45rem 1.3rem;
        font-size: 0.82rem;
        border: 1px solid rgba(45, 212, 191, 0.65);
        background: radial-gradient(circle at top, #14f4ff 0%, #0ea5e9 60%, #0f172a 100%);
        color: #0b1020 !important;
        font-weight: 600;
        letter-spacing: .03em;
        box-shadow: 0 10px 28px rgba(34, 211, 238, 0.7);
    }

        .btn-tab-abak:hover {
            filter: brightness(1.08);
        }

    .cp-row {
        display: grid;
        grid-template-columns: 2.1fr 1.1fr;
        gap: 24px;
    }

    .card-abak {
        background: rgba(3, 11, 32, 0.98);
        border-radius: 26px;
        padding: 24px 26px;
        box-shadow: 0 24px 50px rgba(0, 0, 0, 0.9);
        border: 1px solid rgba(22, 163, 183, 0.25);
    }

    .cp-form-group {
        margin-bottom: 1rem;
    }

    .cp-form-group-inner {
        max-width: 430px;
        margin: 0 auto;
    }

    .cp-form-group label {
        font-size: 0.85rem;
        color: #a5b4fc;
        margin-bottom: 4px;
        display: block;
    }

    .cp-input {
        border-radius: 999px;
        border: none;
        padding: 0.7rem 1rem;
        background: #020617;
        color: #e5e7eb;
        width: 100%;
        font-size: 0.9rem;
        box-shadow: inset 0 0 0 1px rgba(30, 64, 175, 0.7);
        transition: box-shadow 0.15s ease, background 0.15s ease;
    }

        .cp-input:focus {
            outline: none;
            box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.95), 0 0 16px rgba(34, 211, 238, 0.8);
        }

    .cp-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
        margin-top: 1.6rem;
        flex-wrap: wrap;
        max-width: 430px;
        margin-left: auto;
        margin-right: auto;
    }

    .btn-volver-perfil {
        border-radius: 999px;
        font-size: 0.85rem;
        padding: 0.45rem 1.1rem;
        border: 1px solid rgba(148, 163, 184, 0.7);
        background: transparent;
        color: #e5e7eb;
        transition: background 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
    }

        .btn-volver-perfil:hover {
            background: rgba(15, 23, 42, 0.9);
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.9);
            transform: translateY(-1px);
        }

    .btn-guardar-pass {
        border-radius: 999px;
        font-weight: 700;
        padding: 0.7rem 1.7rem;
        font-size: 0.95rem;
        border: none;
        background: linear-gradient(90deg, #00f5ff, #17c3ff);
        color: #02101e;
        letter-spacing: 0.06em;
        box-shadow: 0 18px 36px rgba(34, 211, 238, 0.9);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        transition: box-shadow 0.15s ease, transform 0.1s ease, filter 0.15s ease;
    }

        .btn-guardar-pass i {
            font-size: 0.9rem;
        }

        .btn-guardar-pass:hover {
            filter: brightness(1.08);
            box-shadow: 0 22px 44px rgba(34, 211, 238, 1), 0 0 18px rgba(34, 211, 238, 0.9);
            transform: translateY(-1px);
        }

        .btn-guardar-pass:active {
            transform: translateY(1px) scale(0.99);
            box-shadow: 0 12px 24px rgba(34, 211, 238, 0.7);
        }

        .btn-guardar-pass:focus-visible {
            outline: none;
            box-shadow: 0 0 0 2px #0f172a, 0 0 0 4px #22d3ee, 0 22px 44px rgba(34, 211, 238, 1);
        }

    .cp-tips-card {
        text-align: center;
        padding: 22px 22px 26px;
    }

        .cp-tips-card img {
            width: 90px;
            height: 90px;
            object-fit: contain;
            margin-bottom: 1rem;
        }

        .cp-tips-card h4 {
            margin-bottom: 0.6rem;
            color: #e5e7eb;
        }

        .cp-tips-card p {
            font-size: 0.85rem;
            color: #9ca3af;
        }

    @@media (max-width: 992px) {
        .cp-row {
            grid-template-columns: 1fr;
        }

        .card-abak {
            padding: 20px 18px 24px;
        }
    }
</style>

<div class="manage-container-abak">
    <div class="cp-header">
        <div>
            <h2>Cambiar contraseña</h2>
            <p class="cp-subtitle">Actualiza la clave de acceso a tu cuenta en ABAK.</p>
        </div>

        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-tab-abak">
            Volver al inicio
        </a>
    </div>

    <div class="cp-row">
        <!-- FORMULARIO -->
        <div class="card-abak">
            <form id="change-password-form" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="cp-form-group">
                    <div class="cp-form-group-inner">
                        <label asp-for="Input.OldPassword"></label>
                        <input asp-for="Input.OldPassword" class="cp-input" />
                        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="cp-form-group">
                    <div class="cp-form-group-inner">
                        <label asp-for="Input.NewPassword"></label>
                        <input asp-for="Input.NewPassword" class="cp-input" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="cp-form-group">
                    <div class="cp-form-group-inner">
                        <label asp-for="Input.ConfirmPassword"></label>
                        <input asp-for="Input.ConfirmPassword" class="cp-input" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="cp-actions">
                    <a asp-page="./Index" class="btn btn-volver-perfil">
                        Volver a mi perfil
                    </a>

                    <button type="submit" class="btn btn-guardar-pass">
                        <i class="fa fa-lock"></i>
                        <span>Guardar nueva contraseña</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- CONSEJO -->
        <div class="card-abak cp-tips-card">
            <img src="~/Portada/images/Sak/Sak.duda.png"
                 alt="Sak"
                 onerror="this.style.display='none';" />
            <h4>Consejo de seguridad</h4>
            <p>
                Usa una contraseña única, combina mayúsculas, minúsculas, números y símbolos
                y evita reutilizarla en otros sitios.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
