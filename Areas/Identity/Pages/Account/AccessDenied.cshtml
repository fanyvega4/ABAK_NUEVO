@page
@model ABAK_NUEVO.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "/Areas/Identity/Pages/_Layout.cshtml";
}

<h1 class="text-danger">@ViewData["Title"]</h1>
<p class="text-muted">
    No tienes permisos para acceder a esta sección.
</p>

<div class="border rounded p-3 mt-3">
    <p>
        Si crees que esto es un error o necesitas permisos de administrador,
        por favor contacta al equipo de soporte o al administrador del sistema.
    </p>

    <ul>
        <li>Estás autenticado como: <strong>@User?.Identity?.Name</strong></li>
        <li>Solo los usuarios con rol <strong>Admin</strong> pueden ingresar a esta área.</li>
    </ul>

    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
        Volver al inicio
    </a>
</div>
